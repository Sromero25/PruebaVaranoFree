{
  "name": "varano-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:prod": "npm run migrate:prod && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API central y sincronización offline-first de Varano",
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mysql2": "^3.11.0",
    "typescript": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}