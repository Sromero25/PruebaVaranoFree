PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=varano_app
DB_PASSWORD=password
DB_NAME=varano
DB_POOL=10
# MySQL gestionado (Aiven, PlanetScale, etc.) suele exigir TLS.
DB_SSL=false
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
SESSION_DAYS=30
# Código para crear administradores desde la pantalla "Crear cuenta".
# Déjalo vacío para deshabilitar esa opción (los admins se crean desde el panel).
ADMIN_INVITE_CODE=

# Alternativa a DB_*: una sola URL de conexión.
# Railway la expone como MYSQL_URL y otros servicios como DATABASE_URL.
# MYSQL_URL=mysql://usuario:clave@host:3306/base
